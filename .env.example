# keelie-starter settings. Copy this file to .env. Git ignores .env.

# demo: no Keelie account; an in-memory stand-in plays Keelie, and a button plays Stripe.
# live: calls Keelie with the Provider's admin credential below.
KEELIE_MODE=demo

# Live mode only. From your Provider signup: see the Keelie SDK quickstart, steps 1 and 2.
# This is the ADMIN credential. It can change everything you have in Keelie. Keep it on this server.
KEELIE_API=https://api.keelie.io
KEELIE_TOKEN_URL=https://api.keelie.io/realms/keelie/protocol/openid-connect/token
KEELIE_CLIENT_ID=
KEELIE_CLIENT_SECRET=
KEELIE_ORG_ID=
# The product whose published plans this site sells.
KEELIE_PRODUCT_ID=

# The website. SITE_URL is where Stripe sends the Consumer back after a payment.
SITE_URL=http://127.0.0.1:8000
SITE_NAME=Daylight API
SITE_TAGLINE=Sunrise, sunset and day length for any place on Earth, on any date.
ACCENT_COLOR=#b45309
DATABASE_PATH=site.db

# Change it each time your terms change. A Consumer agrees to this exact string before paying.
TERMS_VERSION=2026-11-23

# Your own words for each scope, as JSON.
SCOPE_WORDS={"sun:read": "Read sunrise, sunset and day length for any place and date"}

# The example call on the credential page: a path after your API's address.
API_EXAMPLE_PATH=/sun?lat=60.17&lon=24.94
