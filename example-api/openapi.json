{
  "openapi": "3.1.0",
  "info": {
    "title": "Daylight",
    "version": "1.0.0"
  },
  "paths": {
    "/sun": {
      "get": {
        "summary": "Get sunrise, sunset and day length",
        "description": "Sunrise, sunset and solar noon in UTC for one place on one date, and the length of the day. Inside the polar circles, `polar` says when the sun does not rise or does not set.",
        "operationId": "getDaylight",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "description": "Latitude in degrees, north positive.",
              "title": "Lat"
            },
            "description": "Latitude in degrees, north positive."
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "description": "Longitude in degrees, east positive.",
              "title": "Lon"
            },
            "description": "Longitude in degrees, east positive."
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The UTC date, as YYYY-MM-DD. Leave it out for today.",
              "title": "Date"
            },
            "description": "The UTC date, as YYYY-MM-DD. Leave it out for today."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Daylight"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Daylight": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "latitude": {
            "type": "number",
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "title": "Longitude"
          },
          "sunrise": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sunrise"
          },
          "sunset": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sunset"
          },
          "solar_noon": {
            "type": "string",
            "format": "date-time",
            "title": "Solar Noon"
          },
          "day_length_seconds": {
            "type": "integer",
            "title": "Day Length Seconds"
          },
          "polar": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "day",
                  "night"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Polar"
          }
        },
        "type": "object",
        "required": [
          "date",
          "latitude",
          "longitude",
          "sunrise",
          "sunset",
          "solar_noon",
          "day_length_seconds",
          "polar"
        ],
        "title": "Daylight"
      },
