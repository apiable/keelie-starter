# Daylight's settings for the Keelie SDK. From your Provider signup: see the SDK quickstart,
# https://github.com/apiable/keelie-sdk/blob/main/docs/quickstart.md
# This is the SDK credential. It reports usage and reads products. Never put the admin credential here.
KEELIE_URL=https://api.keelie.io
KEELIE_TOKEN_URL=https://api.keelie.io/realms/keelie/protocol/openid-connect/token
KEELIE_ISSUER=https://your-slug.keelie.io/realms/your-org-id
KEELIE_ORG_ID=your-org-id
KEELIE_RESOURCE=https://daylight.example.com/v1
KEELIE_SDK_CLIENT_ID=
KEELIE_SDK_CLIENT_SECRET=
